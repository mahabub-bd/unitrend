# Development Dockerfile with hot reload
FROM node:20-alpine

RUN npm install -g pnpm@9

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install

# Copy source code
COPY . .

# Expose the Next.js dev server port
EXPOSE 8000

# Start development server
CMD ["pnpm", "dev"]
